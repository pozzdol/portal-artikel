@base = http://localhost:8080/api/v1
@csrf =

### ===== AUTH =====

### Login (run this first!)
POST {{@base}}/auth/login
Content-Type: application/json

{
  "email": "admin@almaidah.id",
  "password": "<PASSWORD>"
}

###
GET {{@base}}/auth/me

###
POST {{@base}}/auth/logout
X-CSRF-Token: {{@csrf}}

### ===== MEDIA =====

### List media
GET {{@base}}/admin/media?page=1&per_page=20

###
GET {{@base}}/admin/media?q=logo

### Filter by type (image)
GET {{@base}}/admin/media?type=image

### Get media by ids (media picker)
GET {{@base}}/admin/media?ids=1,2,3

### Get one media item
GET {{@base}}/admin/media/1

### Upload media (PNG)
POST {{@base}}/admin/media
X-CSRF-Token: {{@csrf}}

< /opt/portal-berita/backend/uploads/brand/logo.png

### Update media (alt text, caption)
PUT {{@base}}/admin/media/1
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "alt_text": "Logo Almaidah",
  "caption": "Logo resmi yayasan"
}

###
DELETE {{@base}}/admin/media/1
X-CSRF-Token: {{@csrf}}

### ===== KATEGORI =====

### List kategori
GET {{@base}}/admin/categories

###
POST {{@base}}/admin/categories
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "name": "Kategori Baru",
  "slug": "kategori-baru",
  "description": "Deskripsi singkat",
  "parent_id": null,
  "sort_order": 1
}

###
PUT {{@base}}/admin/categories/1
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "name": "Kategori Diperbarui"
}

###
PUT {{@base}}/admin/categories/reorder
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "items": [
    {"id": 1, "parent_id": null, "sort_order": 10},
    {"id": 2, "parent_id": null, "sort_order": 20}
  ]
}

###
DELETE {{@base}}/admin/categories/5
X-CSRF-Token: {{@csrf}}

### ===== TAG =====

### List tag
GET {{@base}}/admin/tags

###
POST {{@base}}/admin/tags
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "name": "Tag Baru",
  "slug": "tag-baru"
}

###
PUT {{@base}}/admin/tags/1
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "name": "Tag Diperbarui"
}

###
POST {{@base}}/admin/tags/1/merge
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "into_id": 2
}

###
DELETE {{@base}}/admin/tags/1
X-CSRF-Token: {{@csrf}}

### ===== ARTIKEL =====

### List artikel (admin)
GET {{@base}}/admin/articles?page=1&per_page=20

###
GET {{@base}}/admin/articles?q=keikhlasan

###
GET {{@base}}/admin/articles?status=published

###
GET {{@base}}/admin/articles?category=kajian

### Slug check
GET {{@base}}/admin/articles/slug-check?slug=artikel-baru&exclude_id=0

### Create artikel
POST {{@base}}/admin/articles
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "title": "Judul Artikel Baru",
  "slug": "artikel-baru",
  "excerpt": "Ringkasan singkat artikel",
  "content_json": {
    "type": "doc",
    "content": []
  },
  "content_html": "<p>Isi artikel</p>",
  "category_id": 2,
  "author_id": 1,
  "tag_ids": [1, 2],
  "new_tags": ["Tag Baru"],
  "is_featured": false,
  "is_breaking": false,
  "cover_media_id": 1,
  "cover_caption": null,
  "event_date": null,
  "event_location": null,
  "seo_title": null,
  "seo_description": null,
  "og_media_id": null,
  "canonical_url": null
}

### Get artikel detail
GET {{@base}}/admin/articles/1

###
PUT {{@base}}/admin/articles/1
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "title": "Judul Diperbarui"
}

### Publish artikel (immediate)
POST {{@base}}/admin/articles/1/publish
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{}

### Publish artikel (scheduled)
POST {{@base}}/admin/articles/1/publish
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "published_at": "2026-09-28T10:00:00+07:00"
}

### Unpublish artikel (back to draft)
POST {{@base}}/admin/articles/1/unpublish
X-CSRF-Token: {{@csrf}}

### Preview token (untuk melihat draft)
GET {{@base}}/admin/articles/1/preview-token

### Delete artikel (soft delete)
DELETE {{@base}}/admin/articles/1
X-CSRF-Token: {{@csrf}}

### Restore artikel
POST {{@base}}/admin/articles/1/restore
X-CSRF-Token: {{@csrf}}

### ===== EVENT =====

### List event
GET {{@base}}/admin/events

###
POST {{@base}}/admin/events
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "title": "Event Baru",
  "slug": "event-baru",
  "summary": "Ringkasan event",
  "description_html": "<p>Deskripsi event</p>",
  "starts_at": "2026-10-01T09:00:00+07:00",
  "ends_at": "2026-10-01T17:00:00+07:00",
  "is_all_day": false,
  "location_name": "Aula Utama",
  "location_address": null,
  "maps_url": null,
  "registration_url": null,
  "cover_media_id": null,
  "status": "published"
}

###
PUT {{@base}}/admin/events/1
X-CSRF-Token: {{@csrf}}
Content-Type: application/json

{
  "title": "Event Diperbarui"
}

###
DELETE {{@base}}/admin/events/1
X-CSRF-Token: {{@csrf}}

