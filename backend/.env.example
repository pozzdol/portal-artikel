# Backend configuration (docs/09 §1). Copy to backend/.env and fill in.
# backend/.env is gitignored; never commit real secrets.

APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://portal:CHANGE_ME@<DB_HOST>:<DB_PORT>/portal_berita?sslmode=require
DB_MAX_CONNS=10

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_TTL_REMEMBER=720h

COOKIE_SECURE=false
COOKIE_DOMAIN=
# Only needed when the frontend calls the API cross-origin (not needed with Next rewrites).
CORS_ORIGINS=
# Peers whose X-Forwarded-For / X-Real-IP are believed (comma-separated IPs/CIDRs,
# "none" = trust nobody). Loopback is right when Next.js runs on the same host.
TRUSTED_PROXIES=127.0.0.0/8,::1/128

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

PUBLIC_SITE_URL=http://localhost:3000
NEXT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
# openssl rand -hex 16 ; must match frontend/.env.local
REVALIDATE_SECRET=CHANGE_ME_openssl_rand_hex_16
# openssl rand -hex 16
VIEW_HASH_SALT=CHANGE_ME_openssl_rand_hex_16

# Only for non-interactive `tool create-superadmin`.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

LOG_LEVEL=info
