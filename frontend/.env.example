API_INTERNAL_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=CHANGE_ME_same_as_backend
# Optional, `next dev` only: comma-separated hostnames allowed to load dev
# resources when the dev server is reached through a tunnel/domain.
# NEXT_ALLOWED_DEV_ORIGINS=
# Only when the API runs on another host (see docs/deploy.md §5): same value
# as backend FRONTEND_PROXY_SECRET, plus the visitor-IP header your platform
# overwrites (x-real-ip: nginx/Vercel, cf-connecting-ip: Cloudflare,
# x-nf-client-connection-ip: Netlify).
# FRONTEND_PROXY_SECRET=
# CLIENT_IP_HEADER=x-real-ip
